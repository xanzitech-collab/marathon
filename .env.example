# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Meta/Xenrio app integration
NEXT_PUBLIC_FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_GRAPH_BASE_URL=https://graph.facebook.com/v20.0

# Xenrio API keys (slot-based, 1..5)
XENRIO_API_KEY_1=
XENRIO_API_KEY_2=
XENRIO_API_KEY_3=
XENRIO_API_KEY_4=
XENRIO_API_KEY_5=

# Gemini API keys (slot-based, 1..5)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Artist monitor
ARTIST_NAME=Only1Marathon
ARTIST_INSTAGRAM_HANDLE=only1marathon
YOUTUBE_API_KEY=

# Scheduler and limits
SCHEDULER_CRON=*/15 * * * *
DEFAULT_MAX_POSTS_PER_DAY=25
HARD_MAX_POSTS_PER_DAY=25
DEFAULT_COOLDOWN_MINUTES=240

# Storage
SUPABASE_MEDIA_BUCKET=bot-media

# Optional token encryption key (for app-layer encryption of provider tokens)
TOKEN_ENCRYPTION_KEY=
